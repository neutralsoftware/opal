@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET @OPAL_INSTALLED_GLM_TARGET@)
    find_dependency(glm CONFIG)
endif()
if(NOT TARGET @OPAL_INSTALLED_SDL_TARGET@)
    find_dependency(SDL3 CONFIG)
endif()

set(Opal_BACKEND "@OPAL_RESOLVED_BACKEND@")
if(Opal_BACKEND STREQUAL "VULKAN")
    find_dependency(Vulkan)
    include("${CMAKE_CURRENT_LIST_DIR}/OpalVulkan.cmake")
    if(NOT TARGET spirv-cross-core)
        find_dependency(spirv_cross_core CONFIG HINTS "$ENV{VULKAN_SDK}")
    endif()
    if(NOT TARGET Opal::Slang)
        set(Opal_FOUND FALSE)
        set(Opal_NOT_FOUND_MESSAGE "Opal requires Slang. Set VULKAN_SDK or pass OpalSlang_ROOT to CMake.")
        return()
    endif()
elseif(Opal_BACKEND STREQUAL "METAL")
    include("${CMAKE_CURRENT_LIST_DIR}/OpalMetal.cmake")
    if(NOT TARGET Opal::MetalFrameworks)
        set(Opal_FOUND FALSE)
        set(Opal_NOT_FOUND_MESSAGE "Opal requires Metal, MetalFX, Cocoa, and QuartzCore.")
        return()
    endif()
else()
    find_dependency(OpenGL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpalTargets.cmake")

if(TARGET Opal::C)
    set(Opal_C_FOUND TRUE)
endif()
check_required_components(Opal)
